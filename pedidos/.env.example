# Frontend de prueba. En Netlify se puede dejar en auto.
VITE_API_MODE=auto
VITE_ENABLE_LOCAL_MOCK=true

# Solo para probar el envío manual a un celular propio. Usar números, sin + ni espacios.
VITE_WHATSAPP_TEST_NUMBER=549XXXXXXXXXX

# El modo mock nunca cobra dinero real.
PAYMENT_PROVIDER=mock

# Completar únicamente en Netlify cuando Nave entregue la documentación y credenciales.
NAVE_ENVIRONMENT=sandbox
NAVE_CLIENT_ID=
NAVE_CLIENT_SECRET=
NAVE_POS_ID=
NAVE_API_BASE_URL=
NAVE_TOKEN_URL=
NAVE_WEBHOOK_SECRET=
